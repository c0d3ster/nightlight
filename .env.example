# Copy to .env and edit. .env is gitignored; this example file is the only
# version that gets committed.

# Parent directory containing your target repos (Modernizer, Fractaleyez, etc.)
# overnight.sh and plan.sh resolve a bare repo name against this path.
PROJECT_REPOS_DIR=/Users/you/Documents/project-repos

# Optional. The model overnight sessions run on when a repo's
# docs/nightlight-meta.json has no "model". Unset means sonnet (cheapest).
# Set opus on a plan with room for it. Use an alias so new releases are
# picked up automatically; a full model id pins one version.
# NIGHTLIGHT_MODEL=opus
